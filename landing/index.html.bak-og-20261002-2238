<body>
  <main class="landing-shell">
    <section class="brand-panel" aria-label="Aureus BTC">
      <div class="brand-lockup">
        <div class="seal" aria-hidden="true">A</div>
        <div>
          <p class="eyebrow">AUREUS BTC</p>
          <p class="edition">Bitcoin &amp; Crypto Intelligence</p>
        </div>
      </div>
      <div class="brand-copy">        <p class="kicker">Bitcoin · Cripto · Mercado</p>
        <h1>Inteligência para Bitcoin e mercados cripto.</h1>
        <p class="intro">Sinais, estrutura de mercado, sentimento e dados on-chain reunidos para leitura rápida de risco, tendência e contexto.</p>
      </div>
      <div class="brand-footer">
        <span>Private access</span>
        <a href="https://szuchmacher.com.br/" target="_blank" rel="noopener noreferrer">Szuchmacher Consultoria</a>
      </div>
    </section>

    <section class="access-panel" aria-label="Acesso ao Aureus BTC">
      <div class="access-box">
        <div class="access-heading">
          <p class="eyebrow">ÁREA RESTRITA</p>
          <h2>Acesse o Aureus BTC</h2>
          <p id="subtitle">Entre com seu email e senha.</p>
        </div>
        <div class="tabs" role="tablist" aria-label="Modo de acesso">
          <button type="button" class="tab active" id="tab-login">Entrar</button>
          <button type="button" class="tab" id="tab-register">Criar conta</button>
        </div>
        <form id="gate-form" novalidate>
          <div class="field hidden" id="field-name">
            <label for="name">Nome</label>
            <input id="name" type="text" autocomplete="name" placeholder="Seu nome" />
          </div>          <div class="field">
            <label for="email">Email</label>
            <input id="email" type="email" autocomplete="email" inputmode="email" autocapitalize="none" spellcheck="false" placeholder="voce@empresa.com" autofocus />
          </div>
          <div class="field">
            <label for="password">Senha</label>
            <input id="password" type="password" autocomplete="current-password" enterkeyhint="go" placeholder="••••••••" />
          </div>
          <button id="submit" type="submit">Entrar</button>
          <p class="error" id="error" role="alert"></p>
        </form>
        <p class="privacy-note">Acesso protegido. Sessão autenticada.</p>
      </div>
    </section>
  </main>
  <script src="/assets/auth.js?v=20261001-mobile-login-2" defer></script>
